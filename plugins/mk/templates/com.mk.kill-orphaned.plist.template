<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Reaps orphaned `claude` processes (re-parented to PID 1 when a terminal is
  closed abruptly) every 60s. See kill-orphaned-claude.sh for the matching logic.

  The ProgramArguments path is filled in with the absolute path to the plugin's
  kill-orphaned-claude.sh by install.sh. Do not edit the rendered copy in
  ~/Library/LaunchAgents; re-run the installer instead.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mk.kill-orphaned</string>
    <key>ProgramArguments</key>
    <array>
        <string>__SCRIPT__</string>
    </array>
    <key>StartInterval</key>
    <integer>60</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/claude-kill-orphaned.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/claude-kill-orphaned.log</string>
</dict>
</plist>
